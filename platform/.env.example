# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). BOTH of these are safe to expose to the
# browser — the anon key only works through row-level security.
#
# Rule #3 reminder: the Supabase project must be created under the
# OWNER's email. Devs get invited as members, never owners.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
