# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). BOTH of these are safe to expose to the
# browser — the anon key only works through row-level security.
#
# Rule #3 reminder: the Supabase project must be created under the
# OWNER's email. Devs get invited as members, never owners.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Phase 3: email sending (server-only — never expose these) ---
# Service-role key: Supabase → Project Settings → API. Used ONLY by the
# cron send route; the email queue functions accept no other caller.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Resend (resend.com) — create under the OWNER's email, add your domain.
RESEND_API_KEY=re_YOUR-KEY
# Default From address (per-workspace override: brand_config.from_email).
EMAIL_FROM=hello@your-domain.com
# Any long random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=GENERATE-A-LONG-RANDOM-STRING
# The deployed site URL (for unsubscribe links in emails).
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
